pipeline {
    agent any

    stages {

        stage('Clone') {
            steps {
                echo 'Cloning successful'
            }
        }

        stage('Compile') {
            steps {
                sh 'javac mul1.java'
            }
        }

        stage('Run') {
            steps {
                sh 'java mul1'
            }
        }

    }
}
